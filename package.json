{
  "name": "frappe-ui",
  "version": "1.0.0-beta.69",
  "description": "A set of components and utilities for rapid UI development",
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.vue",
    "src/molecules/*/index.ts",
    "src/charts/index.ts"
  ],
  "imports": {
    "#components/*": [
      "./src/components/*",
      "./src/components/*.ts",
      "./src/components/*/index.ts"
    ],
    "#molecules/*": [
      "./src/molecules/*",
      "./src/molecules/*.ts",
      "./src/molecules/*/index.ts"
    ],
    "#composables/*": [
      "./src/composables/*",
      "./src/composables/*.ts",
      "./src/composables/*/index.ts"
    ],
    "#utils/*": [
      "./src/utils/*",
      "./src/utils/*.ts",
      "./src/utils/*/index.ts"
    ]
  },
  "bin": {
    "base-props-v1": "./scripts/migrate-base-props-v1.js",
    "list-v1": "./scripts/migrate-list-v1.js",
    "navigation-v1": "./scripts/migrate-navigation-v1.js",
    "overlays-v1": "./scripts/migrate-overlays-v1.js",
    "tokens-v2": "./tailwind/migrate-tokens-v2.js",
    "shortcuts-v1": "./scripts/migrate-shortcuts-v1.js",
    "editor-v1": "./scripts/migrate-editor-v1.js",
    "destinations-v1": "./scripts/migrate-destinations-v1.js",
    "data-v1": "./scripts/migrate-data-v1.js",
    "packaging-v1": "./scripts/migrate-packaging-v1.js"
  },
  "scripts": {
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "test:cypress": "cypress run --component",
    "test:cypress:coverage": "cross-env COVERAGE=true cypress run --component",
    "coverage": "yarn test:coverage && yarn test:cypress:coverage && yarn coverage:merge",
    "coverage:merge": "tsx .github/scripts/merge-coverage.ts",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.node.json",
    "type-check:tsc": "tsc --noEmit -p tsconfig.app.json",
    "format": "prettier -w ./src",
    "bump-and-release": "yarn test && git pull --rebase origin main && yarn run release-patch",
    "release-patch": "yarn version --patch && git push && git push --tags",
    "bump-and-release-beta": "yarn test && git pull --rebase origin main && yarn run release-beta",
    "release-beta": "yarn version --prerelease --preid beta && git push && git push --tags",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "docs:dev": "vitepress dev docs --host",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:gen": "tsx docs/scripts/propsgen.ts",
    "docs:gen:all": "yarn docs:gen --all",
    "docs:check": "tsx docs/scripts/propsgen.ts --check",
    "sync-tokens": "node tailwind/figma-tokens-to-theme.js"
  },
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./experimental": {
      "import": "./experimental.ts",
      "types": "./experimental.ts"
    },
    "./editor": {
      "import": "./src/molecules/editor/index.ts",
      "types": "./src/molecules/editor/index.ts"
    },
    "./list": {
      "import": "./src/molecules/list/index.ts",
      "types": "./src/molecules/list/index.ts"
    },
    "./charts": {
      "import": "./src/charts/index.ts",
      "types": "./src/charts/index.ts"
    },
    "./icons": {
      "types": "./icons/index.ts",
      "import": "./icons/index.ts"
    },
    "./tailwind": {
      "types": "./tailwind/index.d.ts",
      "import": "./tailwind/index.js",
      "default": "./tailwind/index.js"
    },
    "./vite": {
      "types": "./vite/index.d.ts",
      "import": "./vite/index.js"
    },
    "./vite/lucideIconsPlugin": {
      "types": "./vite/lucideIconsPlugin.d.ts",
      "import": "./vite/lucideIconsPlugin.js"
    },
    "./vitepress": {
      "types": "./vitepress/index.d.ts",
      "node": "./vitepress/index.node.ts",
      "default": "./vitepress/index.ts"
    },
    "./style.css": {
      "style": "./src/style.css",
      "import": "./src/style.css"
    },
    "./tsconfig.base.json": {
      "types": "./tsconfig.base.json",
      "default": "./tsconfig.base.json"
    }
  },
  "files": [
    "src",
    "vite",
    "icons",
    "tailwind",
    "vitepress",
    "experimental",
    "experimental.ts",
    "scripts/migrate-shortcuts-v1.js",
    "scripts/migrate-base-props-v1.js",
    "scripts/migrate-editor-v1.js",
    "scripts/migrate-list-v1.js",
    "scripts/migrate-navigation-v1.js",
    "scripts/migrate-overlays-v1.js",
    "scripts/migrate-destinations-v1.js",
    "scripts/migrate-data-v1.js",
    "scripts/migrate-packaging-v1.js",
    "tsconfig.base.json",
    "!**/*.test.ts",
    "!**/*.test.js",
    "!**/*.spec.ts",
    "!**/*.cy.ts",
    "!**/*.story.vue",
    "!**/*.playground.vue",
    "!**/stories",
    "!**/test-helpers.ts",
    "!src/mocks"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frappe/frappe-ui.git"
  },
  "author": "Frappe Technologies Pvt. Ltd.",
  "license": "MIT",
